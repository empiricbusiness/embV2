{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // question-board/ is a SEPARATE application with its own package.json,
  // tsconfig and `@/*` paths. Without excluding it, this project's `**/*.tsx`
  // include swallows its source, resolves its imports against this src/, and
  // fails the typecheck with errors that belong to neither app.
  "exclude": ["node_modules", "question-board"]
}
